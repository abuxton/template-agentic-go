* text=auto

# Go source and Unix automation
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf
*.bash  text eol=lf

# Project configuration and documentation
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Windows-native scripts
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Obvious binaries and archives
*.gif   binary
*.gz    binary
*.jpeg  binary
*.jpg   binary
*.pdf   binary
*.png   binary
*.tar   binary
*.zip   binary
